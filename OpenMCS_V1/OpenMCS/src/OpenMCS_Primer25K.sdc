# Exact-pass quota bundled-data CDC: first-stage hold exceptions
set_false_path -hold -from [get_clocks {clk_50m}] -to [get_regs {pass_limit_meta_135_*}]

# Rising/Falling selector: intentional 50 MHz -> acquisition-clock first-stage synchronizer
set_false_path -hold -from [get_clocks {clk_50m}] -to [get_regs {trigger_falling_meta_135_s0}]
